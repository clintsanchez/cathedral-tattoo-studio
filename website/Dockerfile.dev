# Cathedral Tattoo Studio site: its own dev image, with the code and dependencies inside.
# Named Dockerfile.dev so a host that auto-detects "Dockerfile" does not run the dev server.
FROM node:22-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY . .

EXPOSE 3000
CMD ["npx", "next", "dev", "-H", "0.0.0.0", "-p", "3000"]
